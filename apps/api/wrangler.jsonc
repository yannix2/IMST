{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maarif-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // Reachable only on the school hostname routes added at launch (/api/*, /media/*)
  // and through service bindings. No public workers.dev URL.
  "workers_dev": false,
  "preview_urls": false,

  "services": [{ "binding": "CMS", "service": "maarif-cms" }],

  "ratelimits": [
    {
      "name": "FORM_LIMITER",
      "namespace_id": "1001",
      // 5 submissions per minute per form and IP.
      "simple": { "limit": 5, "period": 60 }
    }
  ]

  // Secrets, set with `wrangler secret put <NAME>` (locally in .dev.vars):
  //   TURNSTILE_SECRET, CMS_API_KEY
}
