{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maarif-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // Reachable only on the school hostname routes added at launch (/api/*, /media/*)
  // and through service bindings. No public workers.dev URL.
  "workers_dev": false,
  "preview_urls": false,

  "services": [
    { "binding": "CMS", "service": "maarif-cms" },
    // Refresh on publish (ADR 007): maarif-api tells maarif-web which pages changed.
    { "binding": "WEB", "service": "maarif-web" }
  ],

  // Resizes CMS photos for the site (ADR 008). Free tier: 5,000 unique transformations a month;
  // results are cached at the edge.
  "images": { "binding": "IMAGES" },

  // Email (ADR 011): Cloudflare Email Service on Workers Paid sends to any recipient (staff
  // notifications, confirmations to families, the newsletter). No destination restriction here.
  // The sender domain (MAIL_DOMAIN) must be onboarded in Email Service > Email Sending.
  "send_email": [{ "name": "EMAIL" }],

  "vars": {
    "ADMIN_URL": "https://cms.yassinekhiari.download",
    // The public site: Turnstile tokens must be solved on this host; links in emails.
    "SITE_URL": "https://yassinekhiari.download",
    // Emails leave from noreply@ / info@ of this domain (packages/mail senders.ts).
    "MAIL_DOMAIN": "yassinekhiari.download"
  },

  // Nightly retention and backup in maarifcms, at 03:00 Tunis time (02:00 UTC); every five minutes,
  // the next batch of a newsletter being sent (wave 4). See src/scheduled.ts.
  "triggers": { "crons": ["0 2 * * *", "*/5 * * * *"] },

  "ratelimits": [
    {
      "name": "FORM_LIMITER",
      "namespace_id": "1001",
      // 5 submissions per minute per form and IP.
      "simple": { "limit": 5, "period": 60 }
    }
  ]

  // Secrets, set with `wrangler secret put <NAME>` (locally in .dev.vars):
  //   TURNSTILE_SECRET, CMS_API_KEY, REVALIDATE_SECRET, MAINTENANCE_SECRET
}
