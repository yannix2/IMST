{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "maarif-cms",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    // Node.js APIs used by Payload
    "nodejs_compat",
    // fetch() may only reach public URLs
    "global_fetch_strictly_public"
  ],
  "observability": { "enabled": true },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // The ONLY Worker bound to the database (ARCHITECTURE.md section 2).
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "d58c0354-c333-4093-8309-377a67bb4dd0",
      "database_name": "maarif-db",
      "remote": true
    }
  ],

  // Private bucket: no public URL; visitors get files through maarif-api.
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "maarif-media"
    }
  ],

  // The admin lives on its own hostname (demo domain, 2026-11-05). No workers.dev URL, so the
  // only public door to maarifcms is the admin login; maarif-api reaches it over the service
  // binding. Secret: PAYLOAD_SECRET (set by the deploy workflow, never in this file).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "cms.yassinekhiari.download", "custom_domain": true }],
  // SITE_URL: the public site, for the admin's "View on site" buttons (wave 3).
  "vars": { "PAYLOAD_PUBLIC_SERVER_URL": "https://cms.yassinekhiari.download", "SITE_URL": "https://yassinekhiari.download" },

  // Refresh on publish (wave 3, ADR 007): after staff publish, maarifcms tells maarif-api which
  // pages changed (src/hooks/revalidate.ts). Secrets: REVALIDATE_SECRET (the same as maarif-api's),
  // MAINTENANCE_SECRET (nightly retention and backup, called by maarif-api's cron).
  "services": [{ "binding": "API", "service": "maarif-api" }]
}
