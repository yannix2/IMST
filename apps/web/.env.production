# Read at build time: pages are pre-rendered, so canonical URLs, hreflang and the sitemap
# are baked into the HTML. Not secret. Switch both at launch.
SITE_URL=https://yassinekhiari.download
SITE_INDEXABLE=false
# Turnstile site key (public, wave 4): the "maarif-site" widget (Cloudflare dashboard > Turnstile),
# set 2026-11-10. Its secret lives only on maarif-api (wrangler secret put TURNSTILE_SECRET).
# The real key only works on the widget's hostnames: to test forms on a local production build,
# set NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA in the shell (it wins over this file).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAF1OxTcTArWvS8sw
