{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "maarif-web",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    // Staging URL until the school hostname is connected; keep SITE_INDEXABLE off until launch.
    "SITE_URL": "https://yassinekhiari.download",
    "SITE_INDEXABLE": "false"
  },

  // The public site holds NO data bindings: everything it shows comes from maarif-api over
  // a private service binding (ARCHITECTURE.md section 2); src/app/api/[...path]/route.ts
  // forwards the browser's /api/* calls through it.
  "services": [{ "binding": "API", "service": "maarif-api" }]
  // With R2 enabled (Workers Paid), the OpenNext page cache moves to R2:
  //   "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "maarif-next-cache" }]
}
